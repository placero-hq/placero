# ==========================================================
# PlaceRo backend — environment variables (Render)
# Copy this file to .env for local dev. Never commit the real .env.
# ==========================================================

# --- Server ---
PORT=4000
NODE_ENV=development

# --- PostgreSQL ---
# Full connection string. On Render, use the "Internal Database URL" from
# your Render PostgreSQL instance so traffic never leaves Render's network.
DATABASE_URL=postgres://placero_user:placero_password@localhost:5432/placero
# Set to true only if your provider requires SSL and you don't already have
# `sslmode=require` in DATABASE_URL (Render's internal URL usually doesn't need this).
DATABASE_SSL=false

# --- Admin authentication ---
# V1 = a single admin account, stored (hashed) in the `admins` table.
# Run `npm run create-admin` once after migrating to create/update this account
# using the values below, then you may remove the plaintext password from here.
ADMIN_USERNAME=placero_admin
ADMIN_PASSWORD=change-this-before-first-run

# Secret used to sign the admin session JWT. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
# Session lifetime
JWT_EXPIRES_IN=12h
# Cookie name for the session token
SESSION_COOKIE_NAME=placero_session

# --- CORS ---
# Comma-separated list of origins allowed to call the admin API
# (your Vercel-hosted /admin origin + local dev).
ADMIN_ALLOWED_ORIGINS=http://localhost:5173,https://placero.in,https://www.placero.in

# --- Public API ---
# Comma-separated list of origins allowed to call the read-only public API
# (mainly used at Vercel build time; also as a client-side fallback).
PUBLIC_ALLOWED_ORIGINS=http://localhost:5173,https://placero.in,https://www.placero.in

# --- Rebuild trigger (optional but recommended) ---
# A Vercel "Deploy Hook" URL. When set, publishing/unpublishing/editing a job
# fires a POST to this URL so Vercel regenerates the static public pages.
# Vercel dashboard -> Project -> Settings -> Git -> Deploy Hooks.
VERCEL_DEPLOY_HOOK_URL=

# --- Google Sheets migration (only needed once, for scripts/import-jobs.js) ---
# Not required at runtime. Export your existing sheet as CSV or JSON and point
# the import script at the file instead — see README.md.
GOOGLE_SHEETS_EXPORT_PATH=./scripts/data/jobs-export.csv
